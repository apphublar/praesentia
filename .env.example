# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Development-only auth bypass. Never enable in production.
ALLOW_DEV_AUTH_BYPASS=false
DEV_SESSION_USER_ID=

# Supabase
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth/session
SESSION_SECRET=replace-with-a-strong-random-secret-at-least-32-bytes
PLATFORM_ADMIN_EMAIL=adm.praesentia@gmail.com

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CAPSULE=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_STORAGE_5GB=
STRIPE_PRICE_STORAGE_10GB=
STRIPE_PRICE_STORAGE_25GB=
STRIPE_PRICE_STORAGE_50GB=
STRIPE_PRICE_AI_INSPIRACAO=
STRIPE_PRICE_AI_CRIATIVO=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI (convite: texto GPT + imagem DALL-E)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Realtime provider placeholder: supabase | pusher | ably | websocket | mock
REALTIME_PROVIDER=mock

# Optional production observability
SENTRY_DSN=
